POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://crm_auth:replace-with-a-long-random-password@database:5432/crm_auth
PUBLIC_BASE_URL=https://crm-api.example.com
ALLOWED_ORIGINS=http://localhost:5173,null
SESSION_DAYS=30
RESET_TOKEN_MINUTES=30
# NAS 부하 보호 및 장애 시 무한 대기 방지
PG_POOL_MAX=10
PG_CONNECT_TIMEOUT_MS=5000
PG_IDLE_TIMEOUT_MS=30000
PG_QUERY_TIMEOUT_MS=60000
# DSM 역방향 프록시 뒤 = 1 (기본). 8787 직접 노출 시 반드시 0
TRUST_PROXY=1

# 계정 정책: 공개 가입 차단(관리자 발급제) + 최초 슈퍼어드민 계정
ALLOW_PUBLIC_SIGNUP=false
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# 메시지 발송사 (미설정 시 발송 안 됨 — pending으로 정직 기록)
# none = 미설정 / http = 범용 HTTP 중계 (엔포 등 발송사 계약 후 설정)
# 결제 링크(카드/가상계좌 수납, 토스페이먼츠) — 키 설정 시 자동 활성화 (docs/PAYMENT-INTEGRATION.md)
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
PAY_REQUEST_EXPIRE_HOURS=72

# 전자상거래법 표시사항 — 결제 페이지 하단에 노출. PG/카드사 심사 전 반드시 채울 것
PAY_MERCHANT_NAME=(주)엠케이유니버셜
PAY_MERCHANT_CEO=
PAY_MERCHANT_BIZ_NO=000-00-00000
PAY_MERCHANT_MAIL_ORDER_NO=제0000-지역-0000호
PAY_MERCHANT_ADDRESS=
PAY_MERCHANT_TEL=
PAY_MERCHANT_EMAIL=
PAY_MERCHANT_PRIVACY_OFFICER=

SMS_PROVIDER=none
SMS_HTTP_URL=
SMS_HTTP_KEY=
SMS_SENDER_ID=
MESSAGE_HOURLY_LIMIT=500

# 재방문 자동 리마인더 (발송사 설정 후 true로)
REMINDER_ENABLED=false
REMINDER_HOUR=10
REMINDER_CYCLE_DAYS=28
REMINDER_MIN_OVERDUE=0
REMINDER_COOLDOWN_DAYS=7

# 지점별 파일 백업 — File Station의 CRM-BACKUP에 매일 04시 JSON+사진 내보내기
BACKUP_HOST_DIR=/volume1/CRM-BACKUP
BACKUP_HOUR=4
BACKUP_KEEP_DAYS=14

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=crm@example.com
SMTP_PASS=replace-with-smtp-password
MAIL_FROM=트로이아르케 CRM <crm@example.com>

# ── 발송사 SOLAPI (문자 SMS/LMS) — 계약 후 아래 3개 채우고 SMS_PROVIDER=solapi 로 바꾸면 발송이 켜진다 ──
# 알림톡은 카카오 템플릿 승인이 필요해 이 어댑터는 모든 유형을 문자로 보낸다.
# SOLAPI_API_KEY=
# SOLAPI_API_SECRET=
# SOLAPI_SENDER=0212345678          # 솔라피에 등록·인증한 발신번호

# ── 본사 AI 키 중계 — 하나라도 넣으면 전 지점 AI 챗봇·피부분석이 지점 키 없이 동작 ──
# AI_OPENAI_API_KEY=
# AI_GEMINI_API_KEY=
# AI_MONTHLY_LIMIT_PER_BRANCH=300    # 지점별 월 호출 한도(0=무제한)
